# ============================================
# STOKVA — Configuration
# Copy this file to .env and adjust values
# ============================================

# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stokva
DB_USER=stokva
DB_PASSWORD=stokva_change_me
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT=30000

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_in_production
JWT_EXPIRES_IN=12h
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:8080,http://localhost:3000

# WebSocket
WS_PATH=/ws

# Weighbridge (serial port)
WEIGHBRIDGE_ENABLED=false
WEIGHBRIDGE_PORT=COM3
WEIGHBRIDGE_BAUDRATE=9600
WEIGHBRIDGE_PARITY=none
WEIGHBRIDGE_DATABITS=8
WEIGHBRIDGE_STOPBITS=1

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Logs
LOG_LEVEL=combined
